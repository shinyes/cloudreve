# Shell scripts are executed inside the container and by CI; CRLF endings break
# them there ("sh: ./entrypoint.sh: not found" or a stray \r in arguments).
*.sh text eol=lf
*.ps1 text eol=crlf

# Git hooks have no extension and are run by sh, so they need the same protection:
# without this a Windows checkout converts them to CRLF and every push fails with a
# shell syntax error.
.githooks/* text eol=lf

# Files whose byte content matters to a build or a runtime comparison.
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.json text eol=lf
*.go text eol=lf
*.mjs text eol=lf

# Binary assets must never be line-ending converted.
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
